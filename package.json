{
  "name": "@rishib1234/document-platform",
  "version": "0.0.0",
  "description": "Domain-neutral platform for document-backed web applications: validated snapshots, caching, Google Drive access, deterministic serialization, and guarded editing.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.17",
    "ajv": "8.17.1",
    "react": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "ajv": "^8.17.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
